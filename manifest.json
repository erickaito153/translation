{
  "manifest_version": 3,
  "name": "Drag Translator",
  "version": "1.2.0",
  "description": "Translate selected text or explain English terms using Gemini.",

  "permissions": [
    "storage",
    "tabs"
  ],

  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],

  "options_page": "options.html"
}